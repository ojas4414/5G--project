# NOTE: this file must stay UTF-8. It was previously saved as UTF-16, which git cannot
# parse -- every rule was silently ignored, which is how the generated output
# directories ended up committed.

# Python
.venv*/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# Node
node_modules/
.next/
out/
.env.local
.env*.local
*.tsbuildinfo

# Generated research artifacts.
#
# The summary tables and plots ARE committed on purpose: they let a freshly deployed
# instance serve /api/results and the plot gallery before anyone clicks "Run Full
# Research", which matters because the free tier's disk is ephemeral.
#
# The raw per-timestep CSVs are not. They are ~15 MB of derived data, they are rewritten
# by every run, and /api/results prefers summary_with_ci95.csv anyway. Regenerate with:
#   python -m src.experiments.run_benchmark_phase2
backend/outputs_phase2/benchmark_results_phase2.csv
backend/outputs/benchmark_results.csv

# Runtime job bookkeeping is never committed.
backend/outputs_phase2/research_jobs.json
backend/outputs_phase2/*.tmp

# Output of the dashboard's "Run Demo Benchmark" button. This is a reduced sweep
# (2 seeds, 3 loads, horizon 120), not the study -- it exists so a demo click can never
# overwrite the committed figures in outputs_phase2/. Nothing here is ever committed.
backend/outputs_demo/

# Build logs
next_frontend/build_output.log
next_frontend/build_output.txt

# OS
.DS_Store
Thumbs.db
