# Copy to .env.local for local development.
#
# NOTE: NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, not read at
# runtime. Changing it on a deployed service requires a rebuild, not just a restart.
#
# Local:      http://localhost:8000
# Deployed:   https://<your-backend-service>.onrender.com   (no trailing slash)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
